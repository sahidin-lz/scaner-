### Langkah 4: Generator LJK PDF (`src/lib/ljkGenerator.ts`)

```ts
import jsPDF from "jspdf";
import QRCode from "qrcode";
import { ANCHORS, OPTIONS, getBubblePosition } from "./ljkLayout";

export interface Student {
  id: string;
  presensi: string;
  nama: string;
  kelas: string;
}

export interface QuestionKey {
  type: "PG" | "PGK";
  answers: string[]; // PG: ["A"] | PGK: ["A", "C", "E"]
  weight: number;    // Misal PG: 2, PGK: 6
}

export interface Exam {
  id: string;
  namaUjian: string;
  mapel: string;
  kelas: string;
  jumlahSoal: number;
  kunciJawaban: Record<string, QuestionKey>;
}

export async function generateClassLJKPdf(exam: Exam, students: Student[]) {
  if (students.length === 0) {
    alert(`Belum ada data siswa untuk kelas ${exam.kelas}.`);
    return;
  }

  const doc = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4" });

  for (let i = 0; i < students.length; i++) {
    const s = students[i];
    if (i > 0) doc.addPage();

    // 1. 4 Kotak Hitam Sudut (Anchor Markers)
    doc.setFillColor(0, 0, 0);
    [ANCHORS.tl, ANCHORS.tr, ANCHORS.bl, ANCHORS.br].forEach((pt) => {
      doc.rect(pt.x, pt.y, ANCHORS.size, ANCHORS.size, "F");
    });

    // 2. Kop & Identitas
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13);
    doc.text("LEMBAR JAWABAN KOMPUTER (LJK)", 105, 22, { align: "center" });
    doc.setFontSize(10);
    doc.setFont("helvetica", "normal");
    doc.text(`${exam.namaUjian} — ${exam.mapel}`, 105, 28, { align: "center" });

    doc.setDrawColor(80);
    doc.rect(24, 35, 125, 32);
    doc.setFontSize(10);
    doc.text(`Nama         : ${s.nama}`, 28, 43);
    doc.text(`Kelas        : ${s.kelas}`, 28, 50);
    doc.text(`No. Presensi : ${s.presensi}`, 28, 57);
    doc.setFontSize(7.5);
    doc.text("Petunjuk: Hitamkan penuh. Nomor bertanda (*) adalah PG Kompleks (boleh >1 jawaban).", 28, 64);

    // 3. QR Code Identitas Siswa + Ujian
    const qrPayload = JSON.stringify({ sId: s.id, eId: exam.id });
    const qrDataUrl = await QRCode.toDataURL(qrPayload, { margin: 1, width: 150 });
    doc.addImage(qrDataUrl, "PNG", 155, 34, 33, 33);

    // 4. Header Kolom
    doc.setFont("helvetica", "bold");
    doc.setFontSize(9);
    [30, 118].forEach((baseX, colIdx) => {
      if (colIdx === 1 && exam.jumlahSoal <= 25) return;
      doc.text("No", baseX - 10, 75);
      OPTIONS.forEach((opt, idx) => {
        doc.text(opt, baseX + idx * 9.5, 75, { align: "center" });
      });
    });

    // 5. Grid Bulatan A-E
    doc.setFont("helvetica", "normal");
    doc.setLineWidth(0.35);
    for (let q = 1; q <= exam.jumlahSoal; q++) {
      const firstBubble = getBubblePosition(q, 0);
      const isPgk = exam.kunciJawaban[String(q)]?.type === "PGK";
      const labelNo = String(q).padStart(2, "0") + (isPgk ? "*" : "");

      doc.setFontSize(8.5);
      doc.text(labelNo, firstBubble.x - 10, firstBubble.y + 1.2);

      OPTIONS.forEach((opt, optIdx) => {
        const pos = getBubblePosition(q, optIdx);
        doc.circle(pos.x, pos.y, pos.radius, "S");
        doc.setFontSize(6.5);
        doc.setTextColor(150);
        doc.text(opt, pos.x, pos.y + 0.9, { align: "center" });
        doc.setTextColor(0);
      });
    }
  }

  doc.save(`LJK_${exam.mapel}_${exam.kelas}.pdf`);
}

