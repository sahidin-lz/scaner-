  const [mapel, setMapel] = useState("Sosiologi");
  const [kelas, setKelas] = useState("XI-A");
  const [jumlahSoal, setJumlahSoal] = useState(40);
  const [bobotPG, setBobotPG] = useState(2);
  const [bobotPGK, setBobotPGK] = useState(6);
  const [kunciText, setKunciText] = useState("");

  useEffect(() => {
    loadInitialData();
  }, []);

  useEffect(() => {
    if (selectedExam) loadExamResults(selectedExam.id);
  }, [selectedExam]);

  async function loadInitialData() {
    const sSnap = await getDocs(collection(db, "students"));
    setStudents(sSnap.docs.map((d) => ({ id: d.id, ...d.data() } as Student)));

    const eSnap = await getDocs(collection(db, "exams"));
    const eList = eSnap.docs.map((d) => ({ id: d.id, ...d.data() } as Exam));
    setExams(eList);
    if (eList.length > 0 && !selectedExam) setSelectedExam(eList[0]);
  }

  async function loadExamResults(examId: string) {
    const q = query(collection(db, "results"), where("examId", "==", examId));
    const snap = await getDocs(q);
    setResults(snap.docs.map((d) => d.data() as ScanResult));
  }

  // 1. Upload Siswa dari Excel -> Auto Simpan ke Firebase
  async function handleImportStudents(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    if (!file) return;
    setLoading(true);
    const parsed = await parseStudentsExcel(file);
    for (const s of parsed) {
      await addDoc(collection(db, "students"), s);
    }
    await loadInitialData();
    setLoading(false);
    alert(`${parsed.length} siswa berhasil disimpan ke database!`);
  }

  // 2A. Upload Kunci Jawaban dari Excel -> Auto Simpan ke Firebase
  async function handleUploadKeyExcel(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    if (!file) return;
    setLoading(true);
    const { kunciMap, jumlahSoal: total } = await parseAnswerKeyExcel(file, bobotPG, bobotPGK);
    await addDoc(collection(db, "exams"), {
      namaUjian,
      mapel,
      kelas,
      jumlahSoal: total,
      kunciJawaban: kunciMap,
    });
    await loadInitialData();
    setLoading(false);
    alert(`Kunci jawaban (${total} soal) dari Excel otomatis tersimpan!`);
  }

  // 2B. Simpan Kunci Jawaban dari Ketikan Manual -> Auto Simpan ke Firebase
  async function handleSaveExamManual() {
    const tokens = kunciText.toUpperCase().split(/[\s,]+/).filter(Boolean);
    const kunciMap: Record<string, QuestionKey> = {};

    for (let i = 0; i < jumlahSoal; i++) {
      const raw = (tokens[i] || "A").replace(/[^A-E]/g, "");
      const answers = Array.from(new Set(raw.split("")));
      const isPgk = answers.length > 1;
      kunciMap[String(i + 1)] = {
        type: isPgk ? "PGK" : "PG",
        answers: answers.length > 0 ? answers : ["A"],
        weight: isPgk ? bobotPGK : bobotPG,
      };
    }

    await addDoc(collection(db, "exams"), {
      namaUjian,
      mapel,
      kelas,
      jumlahSoal,
      kunciJawaban: kunciMap,
    });
    await loadInitialData();
    alert("Kunci jawaban tersimpan otomatis di database!");
  }

  return (
    <main className="max-w-3xl mx-auto p-4 sm:p-6 font-sans">
      <h1 className="text-2xl font-bold mb-4">Scanner LJK Kamera HP (PG & PGK)</h1>

      {/* Navigasi Tab */}
      <div className="grid grid-cols-4 gap-1.5 mb-6 border-b pb-3 text-xs sm:text-sm">
        {(["siswa", "ujian", "scan", "rekap"] as const).map((t) => (
          <button
            key={t}
            onClick={() => setTab(t)}
            className={`py-2 px-2 rounded font-semibold ${
              tab === t ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-700"
            }`}
          >
            {t === "siswa" && "1. Siswa"}
            {t === "ujian" && "2. Kunci & LJK"}
            {t === "scan" && "3. Scan HP"}
            {t === "rekap" && "4. Rekap"}
          </button>
        ))}
      </div>

      {/* TAB 1: DATABASE SISWA */}
      {tab === "siswa" && (
        <div className="space-y-4">
          <div className="p-4 border rounded-lg bg-gray-50 space-y-2">
            <label className="block font-semibold">Upload Daftar Siswa (.xlsx)</label>
            <p className="text-xs text-gray-500">Format kolom Excel: Presensi | Nama | Kelas</p>
            <input type="file" accept=".xlsx,.xls" onChange={handleImportStudents} disabled={loading} />
          </div>
          <p className="text-sm font-medium">Total siswa tersimpan di Firebase: {students.length}</p>
        </div>
      )}

      {/* TAB 2: BUAT/UPLOAD KUNCI & CETAK LJK */}
      {tab === "ujian" && (
        <div className="space-y-5">
          <div className="p-4 border rounded-lg space-y-3">
            <h2 className="font-bold">Buat Paket Ujian Baru</h2>
            <div className="grid grid-cols-2 gap-2 text-sm">
              <input className="border p-2 rounded" value={namaUjian} onChange={(e) => setNamaUjian(e.target.value)} placeholder="Nama Ujian" />
              <input className="border p-2 rounded" value={mapel} onChange={(e) => setMapel(e.target.value)} placeholder="Mapel" />
              <input className="border p-2 rounded" value={kelas} onChange={(e) => setKelas(e.target.value)} placeholder="Kelas (mis: XI-A)" />
              <input className="border p-2 rounded" type="number" max={50} value={jumlahSoal} onChange={(e) => setJumlahSoal(Number(e.target.value))} placeholder="Jumlah Soal" />
              <input className="border p-2 rounded" type="number" value={bobotPG} onChange={(e) => setBobotPG(Number(e.target.value))} placeholder="Bobot PG (mis: 2)" />
              <input className="border p-2 rounded" type="number" value={bobotPGK} onChange={(e) => setBobotPGK(Number(e.target.value))} placeholder="Bobot PGK (mis: 6)" />
            </div>

            {/* Opsi A: Upload Excel Kunci */}
            <div className="p-3 bg-blue-50 border border-blue-200 rounded space-y-1">
              <p className="text-sm font-semibold text-blue-900">Cara Cepat: Upload File Excel Kunci Jawaban</p>
              <p className="text-xs text-blue-700">Kolom Excel: No | Kunci (misal A untuk PG, ACE untuk PGK) | Bobot (opsional). Otomatis tersimpan!</p>
              <input type="file" accept=".xlsx,.xls" onChange={handleUploadKeyExcel} disabled={loading} className="text-sm mt-1" />
            </div>

            {/* Opsi B: Ketik Manual */}
            <div className="space-y-2 pt-2 border-t">
              <p className="text-xs text-gray-600">Atau ketik kunci dipisah spasi (1 huruf = PG, &gt;1 huruf = PGK):</p>
              <textarea
                className="w-full border p-2 rounded font-mono text-sm"
                rows={2}
                value={kunciText}
                onChange={(e) => setKunciText(e.target.value)}
                placeholder="Contoh: A B C D ... AC BDE ABD"
              />
              <button onClick={handleSaveExamManual} className="w-full bg-blue-600 text-white py-2 rounded font-semibold">
                Simpan Kunci Manual
              </button>
            </div>
          </div>

          <div className="space-y-2">
            <h2 className="font-bold">Daftar Ujian & Download LJK PDF</h2>
            {exams.map((ex) => (
              <div key={ex.id} className="flex justify-between items-center p-3 border rounded-lg">
                <div>
                  <p className="font-semibold">{ex.namaUjian} ({ex.kelas})</p>
                  <p className="text-xs text-gray-500">{ex.mapel} • {ex.jumlahSoal} Soal</p>
                </div>
                <button
                  onClick={() => generateClassLJKPdf(ex, students.filter((s) => s.kelas === ex.kelas))}
                  className="bg-green-600 text-white px-3 py-2 rounded text-xs sm:text-sm font-medium"
                >
                  Download LJK PDF
                </button>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* TAB 3: SCANNER KAMERA HP */}
      {tab === "scan" && (
        <div className="space-y-4">
          <select
            className="w-full border p-2.5 rounded-lg font-medium"
            value={selectedExam?.id || ""}
            onChange={(e) => setSelectedExam(exams.find((x) => x.id === e.target.value) || null)}
          >
            {exams.map((ex) => (
              <option key={ex.id} value={ex.id}>{ex.namaUjian} - {ex.kelas}</option>
            ))}
          </select>

          {selectedExam && (
            <CameraScanner
              exam={selectedExam}
              students={students}
              onResultSaved={async (res) => {
                await addDoc(collection(db, "results"), {
                  examId: selectedExam.id,
                  ...res,
                  previewImage: "",
                  scannedAt: new Date().toISOString(),
                });
                setResults((prev) => [res, ...prev]);
              }}
            />
          )}
        </div>
      )}

      {/* TAB 4: REKAP NILAI & EXPORT EXCEL */}
      {tab === "rekap" && (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <h2 className="font-bold">Rekap: {selectedExam?.namaUjian}</h2>
            <button
              onClick={() => selectedExam && exportResultsToExcel(selectedExam.namaUjian, results)}
              className="bg-emerald-600 text-white px-3 py-2 rounded text-sm font-semibold"
            >
              Download Excel (.xlsx)
            </button>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full border text-sm">
              <thead className="bg-gray-100">
                <tr>
                  <th className="p-2 border">No</th>
                  <th className="p-2 border text-left">Nama</th>
                  <th className="p-2 border">Benar</th>
                  <th className="p-2 border">Skor</th>
                  <th className="p-2 border">Status</th>
                </tr>
              </thead>
              <tbody>
                {results.map((r, i) => (
                  <tr key={i} className={r.statusRagu ? "bg-yellow-50" : ""}>
                    <td className="p-2 border text-center">{r.presensi}</td>
                    <td className="p-2 border">{r.nama}</td>
                    <td className="p-2 border text-center text-green-700 font-bold">{r.benar}</td>
                    <td className="p-2 border text-center font-bold">{r.skor}</td>
                    <td className="p-2 border text-center">{r.statusRagu ? "⚠️ Cek" : "✅"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </main>
  );
}

