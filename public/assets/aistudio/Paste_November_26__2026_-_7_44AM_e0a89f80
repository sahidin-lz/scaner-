### Langkah 7: Komponen Kamera HP (`src/components/CameraScanner.tsx`)

```tsx
"use client";
import { useRef, useState, useEffect } from "react";
import { Exam, Student } from "@/lib/ljkGenerator";
import { processCameraFrame, ScanResult } from "@/lib/omrCameraEngine";

interface Props {
  exam: Exam;
  students: Student[];
  onResultSaved: (res: ScanResult) => Promise<void>;
}

export default function CameraScanner({ exam, students, onResultSaved }: Props) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const [cameraOn, setCameraOn] = useState(false);
  const [lastResult, setLastResult] = useState<ScanResult | null>(null);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    return () => stopCamera();
  }, []);

  async function startCamera() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: { ideal: "environment" },
          width: { ideal: 1920 },
          height: { ideal: 1080 },
        },
      });
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        setCameraOn(true);
      }
    } catch {
      alert("Gagal membuka kamera. Pastikan izin kamera aktif & akses via HTTPS (Vercel).");
    }
  }

  function stopCamera() {
    const stream = videoRef.current?.srcObject as MediaStream | null;
    stream?.getTracks().forEach((t) => t.stop());
    setCameraOn(false);
  }

  function handleCapture() {
    const video = videoRef.current;
    const canvas = canvasRef.current;
    if (!video || !canvas) return;

    const vw = video.videoWidth;
    const vh = video.videoHeight;
    const targetRatio = 210 / 297;

    let cropW = vw;
    let cropH = vw / targetRatio;
    if (cropH > vh) {
      cropH = vh;
      cropW = vh * targetRatio;
    }

    const startX = (vw - cropW) / 2;
    const startY = (vh - cropH) / 2;

    canvas.width = 1050;
    canvas.height = 1485;
    const ctx = canvas.getContext("2d")!;
    ctx.drawImage(video, startX, startY, cropW, cropH, 0, 0, canvas.width, canvas.height);

    const result = processCameraFrame(canvas, exam, students);
    setLastResult(result);
  }

  async function handleConfirmSave() {
    if (!lastResult) return;
    setSaving(true);
    await onResultSaved(lastResult);
    setSaving(false);
    setLastResult(null);
  }

  return (
    <div className="space-y-4">
      {!cameraOn ? (
        <button
          onClick={startCamera}
          className="w-full py-4 bg-blue-600 text-white rounded-xl font-bold text-lg shadow"
        >
          📷 Buka Kamera HP untuk Scan LJK
        </button>
      ) : (
        <div className="space-y-3">
          <div className="relative w-full max-w-sm mx-auto aspect-[210/297] bg-black rounded-xl overflow-hidden shadow-lg">
            <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-cover" />
            <div className="pointer-events-none absolute inset-0 border-2 border-green-400/60">
              <div className="absolute top-3 left-3 w-7 h-7 border-4 border-green-400" />
              <div className="absolute top-3 right-3 w-7 h-7 border-4 border-green-400" />
              <div className="absolute bottom-3 left-3 w-7 h-7 border-4 border-green-400" />
              <div className="absolute bottom-3 right-3 w-7 h-7 border-4 border-green-400" />
              <p className="absolute bottom-2 inset-x-0 text-center text-xs text-white bg-black/50 py-1">
                Sejajarkan 4 kotak hitam LJK dengan kotak hijau
              </p>
            </div>
          </div>

          <div className="flex gap-2 max-w-sm mx-auto">
            <button onClick={handleCapture} className="flex-1 py-3 bg-emerald-600 text-white rounded-lg font-bold">
              ⚡ Jepret & Koreksi
            </button>
            <button onClick={stopCamera} className="px-4 py-3 bg-gray-200 text-gray-800 rounded-lg font-medium">
              Tutup
            </button>
          </div>
        </div>
      )}

      <canvas ref={canvasRef} className="hidden" />

      {lastResult && (
        <div className="p-4 border-2 border-blue-500 rounded-xl bg-white shadow-md space-y-3 max-w-sm mx-auto">
          <div className="flex justify-between items-start">
            <div>
              <p className="font-bold text-lg">{lastResult.nama}</p>
              <p className="text-sm text-gray-500">
                Kelas {lastResult.kelas} • Presensi {lastResult.presensi}
              </p>
            </div>
            <span className="text-2xl font-extrabold text-blue-600">{lastResult.skor}</span>
          </div>

          <div className="flex gap-3 text-sm font-medium">
            <span className="text-green-600">Benar: {lastResult.benar}</span>
            <span className="text-red-600">Salah/Parsial: {lastResult.salah}</span>
            <span className="text-gray-500">Kosong: {lastResult.kosong}</span>
          </div>

          {lastResult.statusRagu && (
            <p className="text-xs bg-yellow-100 text-yellow-800 p-2 rounded">
              ⚠️ Ada jawaban dobel atau QR kurang jelas. Periksa pratinjau di bawah.
            </p>
          )}

          <img src={lastResult.previewImage} alt="Hasil koreksi" className="w-full rounded border" />

          <div className="flex gap-2">
            <button
              onClick={handleConfirmSave}
              disabled={saving}
              className="flex-1 py-2.5 bg-blue-600 text-white rounded-lg font-bold"
            >
              {saving ? "Menyimpan..." : "✅ Simpan & Scan Berikutnya"}
            </button>
            <button onClick={() => setLastResult(null)} className="px-4 py-2.5 bg-red-100 text-red-700 rounded-lg font-medium">
              Ulangi
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

